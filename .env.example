# =============================================================================
# .env.example — copy to .env and fill in your values
# =============================================================================

# HuggingFace token (required to download models)
HF_TOKEN=hf_your_token_here

# MCP server bind settings
MCP_HOST=0.0.0.0
MCP_PORT=8500

# Model to use — must match a backend in models/
# Options: qwen_image_2_1
IMAGE_MODEL=qwen_image_2_1

# Image output directory (inside container)
IMAGE_OUTPUT_DIR=/outputs

# Diffusion settings
TORCH_DTYPE=bfloat16
# Optional overrides of the model's defaults (40 steps, CFG 1.0 = guidance off).
# Leave unset to use the backend-native defaults.
# MAX_INFERENCE_STEPS=40
# DEFAULT_CFG_SCALE=1.0

# Device-memory cap in GB (accelerate max_memory). Unset = uncapped.
# Qwen-Image-2.1 needs ~33 GB of weights; measured peaks are ~68 GB (2K generate)
# and ~40 GB (edit at the default EDIT_OUTPUT_RESOLUTION=1024);
# stop vLLM first. On unified memory the cap does NOT reduce total RAM use.
# IMAGE_GPU_MEMORY_LIMIT=40

# Edit output size: edit_image results match the last reference's aspect ratio at
# about EDIT_OUTPUT_RESOLUTION^2 pixels of area. Multiple of 32, 512-2048.
# Default 1024: the spec 006 A/B test found 2048 edits over-sharpened and
# ignoring instructions. Empty = default.
# EDIT_OUTPUT_RESOLUTION=1024

# Total HTTP request-body limit in MB (the MCP SDK's own default is 4). Unset =
# computed: ceil(10 x MAX_REFERENCE_IMAGE_MB x 4/3) + 1 = 268 at the default of
# 20, enough for 10 base64 references. Must be >= 4. Prefer image_ids for large
# or chained images: they move no bytes.
# MAX_REQUEST_BODY_MB=268

# Docker bridge network name used by docker-compose.override.yml
# (default: ai-litellm-proxy_ai-bridge, the LiteLLM stack's network).
# AI_BRIDGE_NETWORK=ai-litellm-proxy_ai-bridge

# Max decoded size (MB) of one base64 reference image for edit_image
MAX_REFERENCE_IMAGE_MB=20
